# PostgreSQL (required). Free tier: https://neon.tech or Vercel Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
PORT=5000
JWT_ACCESS_SECRET="dev_lms_access_secret_change_in_production"
JWT_REFRESH_SECRET="dev_lms_refresh_secret_change_in_production"
FRONTEND_URL="http://localhost:3000"
# Optional: extra CORS origins (comma-separated production URLs)
# ALLOWED_ORIGINS="https://my-app.vercel.app"
# Set to "false" to block *.vercel.app preview URLs on the API
# ALLOW_VERCEL_PREVIEWS="true"
NODE_ENV="development"
# OPENAI_API_KEY=""
